# Git Configuration

# Ignore OS files
.DS_Store
Thumbs.db
desktop.ini

# Ignore editor files
.vscode/
.idea/
*.swp
*.swo
*~
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore database files
database/*.db
database/*.db-wal
database/*.db-shm

# Ignore logs
logs/
*.log

# Ignore coverage
coverage/
.nyc_output

# Ignore temp files
.tmp/
.temp/
temp/

# Ignore build output
dist/
build/
output/